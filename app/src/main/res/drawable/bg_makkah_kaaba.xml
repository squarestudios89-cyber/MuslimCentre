<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="300dp"
    android:viewportWidth="200"
    android:viewportHeight="300">

    <!-- Deep Brown/Gold Gradient Background -->
    <path android:pathData="M0,0h200v300h-200z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="100"
                android:startY="0"
                android:endX="100"
                android:endY="300"
                android:type="linear">
                <item android:color="#FF1A120B" android:offset="0.0" />
                <item android:color="#FF2C1F10" android:offset="0.5" />
                <item android:color="#FF3E2B15" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Golden Radial Rays in background -->
    <path android:pathData="M0,0h200v300h-200z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="200"
                android:gradientRadius="160"
                android:type="radial">
                <item android:color="#60E5C158" android:offset="0.0" />
                <item android:color="#00E5C158" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Kaaba Motif at Bottom Center -->
    <!-- Kaaba Cube -->
    <path
        android:fillColor="#FF111111"
        android:pathData="M65,180 h70 v80 h-70 z" />

    <!-- Gold Kiswah Band -->
    <path
        android:fillColor="#FFE5C158"
        android:pathData="M65,195 h70 v10 h-70 z" />

    <!-- Kaaba Door -->
    <path
        android:fillColor="#FFE5C158"
        android:pathData="M105,225 h15 v35 h-15 z" />

    <!-- Minarets Background Silhouettes -->
    <path
        android:fillColor="#33E5C158"
        android:pathData="M30,300v-160l6,-12l6,12v160z M158,300v-160l6,-12l6,12v160z" />

    <!-- Dark Overlay Scrim for text readability -->
    <path android:pathData="M0,0h200v300h-200z" android:fillColor="#66100B06" />
</vector>
