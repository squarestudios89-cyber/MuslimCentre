<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="300dp"
    android:viewportWidth="200"
    android:viewportHeight="300">

    <!-- Deep Emerald Green Background -->
    <path android:pathData="M0,0h200v300h-200z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="100"
                android:startY="0"
                android:endX="100"
                android:endY="300"
                android:type="linear">
                <item android:color="#FF031F17" android:offset="0.0" />
                <item android:color="#FF0B4232" android:offset="0.6" />
                <item android:color="#FF135E48" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Green Dome Motif (Al-Masjid an-Nabawi) -->
    <path
        android:fillColor="#FF0D805B"
        android:pathData="M50,220 C50,160 80,140 100,130 C120,140 150,160 150,220 Z" />

    <path
        android:fillColor="#FFE5C158"
        android:pathData="M98,110 h4 v20 h-4 z M95,110 h10 v4 h-10 z" />

    <!-- Minaret -->
    <path
        android:fillColor="#FF0B4232"
        android:pathData="M25,300 v-180 l5,-10 l5,10 v180 z" />

    <!-- Geometric Arabesque Accent Ring -->
    <path android:pathData="M0,0h200v300h-200z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="150"
                android:gradientRadius="140"
                android:type="radial">
                <item android:color="#30E5C158" android:offset="0.0" />
                <item android:color="#00E5C158" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Scrim Overlay -->
    <path android:pathData="M0,0h200v300h-200z" android:fillColor="#55031F17" />
</vector>
